# Neon PostgreSQL connection string (required at runtime for all DB pages/actions)
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Auth.js (NextAuth v5) — required
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-long-random-string
# Base URL of the app (dev + prod). Used for redirects/callbacks.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Optional: force the canonical host in production behind a proxy.
# AUTH_TRUST_HOST=true

# Google OAuth — required (Google is the ONLY sign-in method; no passwords)
# Google Cloud Console authorized redirect URI: {AUTH_URL}/api/auth/callback/google
#   local:      http://localhost:3000/api/auth/callback/google
#   production: https://your-domain/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Coach allowlist (comma-separated Google emails). The first time one of these
# signs in with Google, a trainer account is created automatically.
COACH_EMAILS=harshgorule24@gmail.com,neerajkushwaha0401@gmail.com
